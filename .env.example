# Copy to .env and fill in. Never commit .env.

# Storage: empty = in-memory (lost on restart). Postgres needs the pgvector extension.
DATABASE_URL=

# Embeddings: "openai" (text-embedding-3-small) or "local" (fastembed, `uv sync --extra local`)
EMBEDDER=openai

# LLM: openai | groq | gemini | nvidia | cheapllm | qwen | deepseek
# Only providers with a key show up in the UI; LLM_PROVIDER is the default choice.
# Model lists per provider are fixed in src/biography_rag/llm/providers.py.
LLM_PROVIDER=openai
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
CHEAPLLM_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional: token required to delete corpora through the API
ADMIN_TOKEN=

# Optional: one shared HTTP Basic password for the whole site (any username). Empty = open.
SITE_PASSWORD=
