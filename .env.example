# Copy to .env and fill in. Never commit .env.

# Storage: empty = in-memory (lost on restart). Postgres needs the pgvector extension.
DATABASE_URL=

# Embeddings: "openai" (text-embedding-3-small) or "local" (fastembed, `uv sync --extra local`)
EMBEDDER=openai

# LLM: openai | qwen | deepseek (only providers with a key show up in the UI)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional: token required to delete corpora through the API
ADMIN_TOKEN=
