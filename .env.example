# Copy to .env and fill in. Never commit .env.

# Storage: empty = in-memory (lost on restart). Postgres needs the pgvector extension.
DATABASE_URL=

# Embeddings: "openai" (text-embedding-3-small) or "local" (fastembed, `uv sync --extra local`)
EMBEDDER=openai

# LLM: openai | groq | gemini | nvidia | cheapllm | qwen | deepseek
# Only providers with a key show up in the UI; LLM_PROVIDER is the default choice.
# Model lists per provider are fixed in src/biography_rag/llm/providers.py.
LLM_PROVIDER=openai
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
CHEAPLLM_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optional: token required to delete corpora through the API
ADMIN_TOKEN=

# Optional: one shared HTTP Basic password for the whole site (any username). Empty = open.
SITE_PASSWORD=

# --- Retrieval tuning (see the "Retrieval" section of README.md) ---------------
# Cosine floor for the dense arm, applied in SQL before the row limit. 0 = off.
# Pick it with: uv run python scripts/calibrate_similarity.py --person "Name" corpus/raw/*.txt
MIN_SIMILARITY=0.25
TOP_K=6
CANDIDATE_K=24
MAX_PER_DOC=0          # passages from one book in the top-k; 0 = no cap (measured better)
NEIGHBOUR_RADIUS=1     # neighbours a hit brings a seam of; 0 = the hit alone
SEAM_CHARS=240         # how many chars of the preceding passage travel with the hit; 0 = no seam
MAX_NUMBER_DENSITY=0.15  # skip back-of-book index pages; empty = keep them
# A second model call reorders the pool (one call per question). Adds precision, not recall.
RERANK=false
RERANK_POOL=12
# A model call writes a hypothetical passage plus two rephrasings to search with.
# The invented text is never shown to the reader or counted as evidence.
EXPAND_QUERIES=false
